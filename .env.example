# ---------- Target ----------
CINEMA_ID=37534
CITY_ID=10
CINEMA_NAME=MOViE MOViE影城（前滩太古里店）
TARGET_MOVIE=奥德赛
TARGET_MOVIE_ALIASES=奥德赛,The Odyssey
TARGET_FORMAT_KEYWORD=IMAX
TIMEZONE=Asia/Shanghai

# Optional: copy your maoyan.com cookie here only if anonymous requests are blocked.
# MAOYAN_COOKIE=

# ---------- Email ----------
# Examples:
# Gmail:  smtp.gmail.com / 465 (app password)
# Outlook: smtp.office365.com / 587
# QQ:     smtp.qq.com / 465 (authorization code)
# 163:    smtp.163.com / 465 (authorization code)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_or_authorization_code
EMAIL_FROM=your_email@example.com
EMAIL_TO=your_email@example.com
SMTP_USE_SSL=true
SMTP_STARTTLS=false

# First execution only creates a baseline by default, so you don't receive a flood of old sessions.
NOTIFY_ON_FIRST_RUN=false

# ---------- Files ----------
STATE_PATH=data/state.json
HISTORY_PATH=data/history.csv
